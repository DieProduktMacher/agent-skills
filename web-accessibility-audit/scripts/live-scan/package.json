{
  "name": "a11y-live-scan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based accessibility scan templates (axe-core, pa11y-ci, Lighthouse)",
  "scripts": {
    "axe": "node run-axe.mjs",
    "pa11y": "pa11y-ci --config .pa11yci.json",
    "lighthouse": "lighthouse --only-categories=accessibility --output=json --output-path=./lighthouse-a11y.json --quiet --chrome-flags=--headless",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "audit": "node run-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "axe-core": "^4.10.0",
    "playwright": "^1.48.0",
    "pa11y-ci": "^3.1.0",
    "lighthouse": "^12.0.0",
    "@lhci/cli": "^0.14.0",
    "pngjs": "^7.0.0"
  }
}